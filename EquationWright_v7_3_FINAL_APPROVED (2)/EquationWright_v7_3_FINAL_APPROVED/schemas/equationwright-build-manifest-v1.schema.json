{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equationwright.org/schemas/equationwright-build-manifest-v1.schema.json",
  "title": "EquationWright Deterministic Build Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaRevision",
    "buildToolVersion",
    "encoding",
    "lineEndings",
    "moduleOrder",
    "profiles",
    "schemas",
    "vendor",
    "outputs"
  ],
  "properties": {
    "format": {
      "const": "equationwright-build-manifest-v1"
    },
    "schemaRevision": {
      "const": 1
    },
    "buildToolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sourceRevision": {
      "type": "string",
      "maxLength": 240
    },
    "encoding": {
      "const": "utf-8"
    },
    "lineEndings": {
      "const": "lf"
    },
    "moduleOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "vendor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online",
        "offline"
      ],
      "properties": {
        "online": {
          "$ref": "#/$defs/output"
        },
        "offline": {
          "$ref": "#/$defs/output"
        }
      }
    },
    "requiresExtensions": {
      "$ref": "#/$defs/requiresExtensions"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibilityId": {
      "type": "string",
      "pattern": "^ewac:sha256:[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "identifierMapString": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 240
      }
    },
    "engineFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appVersion",
        "assessmentCompatibilityId",
        "determinismProtocol",
        "catalogDigest"
      ],
      "properties": {
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assessmentCompatibilityId": {
          "$ref": "#/$defs/compatibilityId"
        },
        "determinismProtocol": {
          "const": "equationwright-determinism-v1"
        },
        "catalogDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      },
      "additionalProperties": true
    },
    "requiresExtensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "path",
        "role",
        "sha256",
        "determinismCritical"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "role": {
          "enum": [
            "html-shell",
            "style",
            "core",
            "catalog",
            "semantic",
            "generator",
            "engine",
            "protocol",
            "adaptive",
            "ui",
            "bootstrap"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "determinismCritical": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "buildVariant",
        "appVersion",
        "assessmentCompatibilityId"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "buildVariant": {
          "enum": [
            "online",
            "offline"
          ]
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assessmentCompatibilityId": {
          "$ref": "#/$defs/compatibilityId"
        }
      }
    }
  }
}
